# 1Password references only, never values (design D4). scripts/tofu.py resolves them with
# `op run --env-file`, for one run, in account l-a-u.1password.com.
TF_VAR_github_app_pem="op://troupe.run/troupe-run-infrastructure/private key"
TF_VAR_state_passphrase="op://troupe.run/troupe-run-infrastructure tofu state/password"
TF_VAR_billing_email="op://troupe.run/troupe-run-infrastructure tofu state/billing email"
TF_VAR_cloudflare_api_token="op://troupe.run/troupe-run cloudflare dns/credential"
